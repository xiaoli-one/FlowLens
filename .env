# 未设置 `LLM_PROTOCOL` 时默认使用 OpenAI-compatible Chat Completions：
LLM_API_KEY=sk-
LLM_MODEL_ID=gpt-5.4
LLM_BASE_URL=https://


# 也可以通过 `LLM_PROTOCOL` 接入其他协议：

# # OpenAI Responses API
# LLM_PROTOCOL=openai_responses
# LLM_API_KEY=sk-...
# LLM_MODEL_ID=gpt-4.1-mini
# LLM_BASE_URL=https://api.openai.com/v1

# # Anthropic Messages API
# LLM_PROTOCOL=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL_ID=claude-3-5-sonnet-latest
# LLM_BASE_URL=https://api.anthropic.com

# # Gemini generateContent
# LLM_PROTOCOL=gemini
# LLM_API_KEY=...
# LLM_MODEL_ID=gemini-1.5-pro
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# # Ollama 本地模型
# LLM_PROTOCOL=ollama
# LLM_MODEL_ID=qwen2.5:14b
# LLM_BASE_URL=http://127.0.0.1:11434

# # Azure OpenAI Chat Completions
# LLM_PROTOCOL=azure_openai
# LLM_API_KEY=...
# LLM_MODEL_ID=deployment-name
# LLM_BASE_URL=https://example.openai.azure.com/openai/deployments/deployment-name
# LLM_API_VERSION=2024-02-15-preview
